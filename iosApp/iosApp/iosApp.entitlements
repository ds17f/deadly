<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Allow outgoing network connections (required for GitHub API and downloads) -->
	<key>com.apple.security.network.client</key>
	<true/>
	<key>com.apple.developer.associated-domains</key>
	<array>
		<string>applinks:share.thedeadly.app</string>
		<string>applinks:share.thedeadly.app?mode=developer</string>
	</array>
</dict>
</plist>
